// Prisma schema: the single source of truth for JobPilot's database.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid()) // primary key, auto-generated
  email     String   @unique
  name      String
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // auto-set on every update

  resume       Resume[]
  applications Application[]
}

model Resume {
  id         String    @id @default(cuid())
  title      String
  content    String
  archivedAt DateTime?

  userId       String
  owner        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Company {
  id      String  @id @default(cuid())
  name    String
  website String?

  jobs Job[]
}

model Job {
  id          String  @id @default(cuid())
  title       String
  url         String
  description String
  location    String?

  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  application Application[]
}

model Application {
  id         String            @id @default(cuid())
  status     ApplicationStatus @default(DISCOVERED)
  matchScore Int?
  notes      String?
  appliedAt  DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

enum ApplicationStatus {
  DISCOVERED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}
