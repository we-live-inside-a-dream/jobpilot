# Copy this file to .env and fill in real values. Never commit .env.
# Neon fills these in for you (`neon env pull`, or Neon console → Connect).

# Postgres. The app uses the pooled URL; `prisma migrate` uses the direct one.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="main"

# Neon object storage (the `assets` bucket in neon.ts), S3-compatible.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
